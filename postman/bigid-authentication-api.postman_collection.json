    "_postman_id": "7f3023f0-3d61-455c-8ea4-1a5096587367",
    "name": "BigID Actionable Insights Authentication API",
    "description": "Authenticate against a BigID deployment using either user credentials (username/password) or a long-lived user token. Exchange a user token for a short-lived system token (session token) used to authorize subsequent calls against the BigID REST API.\n\nContact Support:\n Name: BigID Support\n Email: support@bigid.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
