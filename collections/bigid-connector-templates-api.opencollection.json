{
  "opencollection": "1.0.0",
  "info": {
    "name": "BigID Authentication Actionable Insights Connector Templates API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Connector Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Connector Templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.bigid.tools/api/v1/ds-templates",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List the connector templates available in this BigID deployment."
        },
        {
          "info": {
            "name": "Get A Connector Template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.bigid.tools/api/v1/ds-templates/:type",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "path",
                "description": "The connector template type, e.g. rdb-mysql."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a connector template for a specific data source type (e.g. rdb-mysql)."
        }
      ]
    }
  ],
  "bundled": true
}